# Postgres (Neon via Vercel Marketplace sets this automatically). Without it the site runs in demo mode.
DATABASE_URL=
# Random 32+ character string used to sign login sessions
AUTH_SECRET=
# Comma-separated emails that can open /en/admin once they register with that email
ADMIN_EMAILS=mahmoarts@gmail.com
# Tap Payments secret key (sk_test_... or sk_live_...). Enables BenefitPay + cards checkout.
TAP_SECRET_KEY=
# WhatsApp support number, digits only with country code, e.g. 97333000000
NEXT_PUBLIC_WHATSAPP=
# Public site address, e.g. https://ator.bh
NEXT_PUBLIC_SITE_URL=
